# LLM Provider: "ollama" for local zero-cost generation, "openai" for hosted.
# Changing the provider/model does not affect the retrieval pipeline.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (only required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranker Model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Qdrant Configuration
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag

# Chunking Configuration (units: characters, using Python len())
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Retrieval Configuration
DENSE_TOP_K=10
BM25_TOP_K=10
RRF_K=60
RERANK_TOP_N=5
